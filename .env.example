ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://royale:royale_dev_password@localhost:5432/royale_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ENCRYPTION_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=royale
S3_SECRET_KEY=royale_dev_password
S3_BUCKET_NAME=royale-platform

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=60

OTEL_SERVICE_NAME=royale-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
