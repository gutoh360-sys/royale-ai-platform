ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://royale:royale_dev_password@localhost:5432/royale_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ENCRYPTION_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_AUTHORIZE_URL=https://bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://api.bling.com.br/oauth/token
BLING_REVOKE_URL=https://api.bling.com.br/oauth/revoke
BLING_REQUEST_TIMEOUT_SECONDS=30.0
BLING_OAUTH_STATE_TTL_SECONDS=600
BLING_ACCESS_TOKEN_MARGIN_SECONDS=60
BLING_REFRESH_TOKEN_LIFETIME_DAYS=30
BLING_MAX_REQUESTS_PER_SECOND=3.0
BLING_MAX_RETRIES=1
BLING_MAX_BACKOFF_SECONDS=5.0
BLING_TEST_ENDPOINT=/produtos?limite=1

AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=royale
S3_SECRET_KEY=royale_dev_password
S3_BUCKET_NAME=royale-platform

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=60

OTEL_SERVICE_NAME=royale-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
