# ─── Royale Executive Insight Platform ──────────────────────────────
# Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ────────────────────────────────────────────────────────────────────

# ─── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# ─── Backend API ────────────────────────────────────────────────────
# Public URL of the Royale backend (used by browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal URL for server-side API routes (can be localhost)
BACKEND_URL=http://localhost:8000

# ─── Server-side Auth (NEVER expose to browser) ────────────────────
# Admin credentials for server-side proxy to protected backend endpoints
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# ─── Secrets (required for auth — set AFTER auth migration) ─────────
# Generate with: openssl rand -hex 32
# APP_SECRET=
# SESSION_SECRET=
